GRAVEDIGGER_DATABASE_PATH=data/gravedigger.sqlite
GRAVEDIGGER_AUTH_DIR=data/auth
GRAVEDIGGER_GROUP_JIDS=120363000000000000@g.us
GRAVEDIGGER_DIGEST_RECIPIENT=+15550123456
# Optional dedicated group for automatic newsletters; never include it in the source allowlist.
GRAVEDIGGER_DIGEST_GROUP_JID=
GRAVEDIGGER_LOG_LEVEL=info
# Lunaroute takes precedence when its key is set.
LUNAROUTE_API_KEY=
LUNAROUTE_MODEL=deepseek-4.1-flash
# Legacy provider, used only when LUNAROUTE_API_KEY is absent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
GRAVEDIGGER_AUTO_DIGEST_ENABLED=false
GRAVEDIGGER_DIGEST_HOUR=8
GRAVEDIGGER_DIGEST_MINUTE=0
GRAVEDIGGER_DIGEST_TIME_ZONE=Pacific/Auckland
GRAVEDIGGER_DIGEST_LOOKBACK_HOURS=24
# Optional independent private subscriptions; each id gets its own delivery record.
GRAVEDIGGER_ADDITIONAL_DIGESTS=[]
